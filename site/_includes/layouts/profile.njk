---
layout: layouts/base.njk
---
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Person",
  "name": {{ name | dump | safe }},
  "jobTitle": {{ (title or '') | dump | safe }},
  {% if company %}"worksFor": { "@type": "Organization", "name": {{ company | dump | safe }} },{% endif %}
  {% if location %}"address": { "@type": "PostalAddress", "addressLocality": {{ location | dump | safe }} },{% endif %}
  "url": "https://directory.grcengclub.com/engineers/{{ github }}/",
  "image": "https://github.com/{{ github }}.png",
  "memberOf": { "@type": "Organization", "name": "GRC Engineering Club", "url": "https://grcengclub.com" },
  "sameAs": [
    "https://github.com/{{ github }}"{% if linkedin %},
    {{ linkedin | dump | safe }}{% endif %}{% if website %},
    {{ website | dump | safe }}{% endif %}
  ]
}
</script>
{% set socialData = {
  github: github,
  linkedin: linkedin,
  twitter: twitter,
  bluesky: bluesky,
  youtube: youtube,
  huggingface: huggingface,
  blog: blog,
  website: website,
  portfolio: portfolio,
  credly: credly
} %}
{% set primarySocial = "linkedin" if linkedin else "github" %}
<div class="profile">
  <div class="profile-back">
    <a href="/" data-directory-back>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 18l-6-6 6-6"/></svg>
      <span>Back to directory</span>
    </a>
  </div>

  <div class="profile-header">
    <img
      src="https://github.com/{{ github }}.png?size=200"
      alt=""
      class="profile-avatar"
      width="96"
      height="96"
      loading="eager"
      fetchpriority="high"
      data-initial="{{ name | first }}"
    >
    <div class="profile-info">
      <h1 class="profile-name">{{ name }}</h1>
      {% if title %}<p class="profile-title">{{ title }}</p>{% endif %}
      {% if company or location %}
      <p class="profile-meta">
        {% if company %}<span>{{ company }}</span>{% endif %}
        {% if company and location %}<span aria-hidden="true"> · </span>{% endif %}
        {% if location %}<span>{{ location }}</span>{% endif %}
      </p>
      {% endif %}
      <ul class="profile-socials" aria-label="Links">
        {% for social in socials %}
          {% set val = socialData[social.key] %}
          {% if val or social.alwaysShow %}
            {% set href = social | socialUrl(val or github) %}
            <li><a href="{{ href }}" target="_blank" rel="noopener"><span aria-hidden="true">{{ social.icon | safe }}</span><span>{{ social.label }}</span></a></li>
          {% endif %}
        {% endfor %}
      </ul>
    </div>
  </div>

  <div class="profile-layout">
    <div class="profile-main">
      <section class="profile-expertise profile-panel" aria-label="Expertise">
        {% if specializations and specializations.length %}
        <div class="profile-expertise-group">
          <h2>Specializations</h2>
          <div class="tags">
            {% for s in specializations %}<span class="tag tag-accent">{{ s }}</span>{% endfor %}
          </div>
        </div>
        {% endif %}

        {% if frameworks and frameworks.length %}
        <div class="profile-expertise-group">
          <h2>Frameworks</h2>
          <div class="tags">
            {% for f in frameworks %}<span class="tag tag-outline">{{ f }}</span>{% endfor %}
          </div>
        </div>
        {% endif %}

        {% if certifications and certifications.length %}
        <div class="profile-expertise-group">
          <h2>Certifications</h2>
          <div class="tags">
            {% for c in certifications %}<span class="tag tag-cert">{{ c }}</span>{% endfor %}
          </div>
        </div>
        {% endif %}

        {% if languages and languages.length %}
        <div class="profile-expertise-group">
          <h2>Languages &amp; tools</h2>
          <div class="tags">
            {% for l in languages %}<span class="tag tag-language">{{ l }}</span>{% endfor %}
          </div>
        </div>
        {% endif %}
      </section>

      {% if content | trim %}
      <section class="profile-body profile-panel" aria-label="About">
        {{ content | safe }}
      </section>
      {% endif %}

      {% if projects and projects.length %}
      <section class="profile-projects profile-panel">
        <h2>Projects</h2>
        <ul class="project-list">
          {% for p in projects %}
          <li class="project-item">
            {% if p.url %}
            <a href="{{ p.url }}" target="_blank" rel="noopener" class="project-name">{{ p.name }}<svg class="external-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg><span class="sr-only"> (opens in new tab)</span></a>
            {% else %}
            <span class="project-name">{{ p.name }}</span>
            {% endif %}
            {% if p.description %}<p class="project-desc">{{ p.description }}</p>{% endif %}
          </li>
          {% endfor %}
        </ul>
      </section>
      {% endif %}
    </div>

    <aside class="profile-sidebar" aria-label="Availability and contact">
      <div class="profile-side-card">
        <h2>Open to</h2>
        {% if available_for and available_for.length %}
        <div class="profile-side-tags">
          {% for a in available_for %}<span class="tag tag-available">{{ a | availabilityLabel }}</span>{% endfor %}
        </div>
        {% else %}
        <p class="profile-side-text">Not listed</p>
        {% endif %}

        {% for social in socials %}
          {% if social.key == primarySocial %}
          <a href="{{ social | socialUrl(socialData[social.key]) }}" class="btn btn-primary profile-contact-btn" target="_blank" rel="noopener">
            <span aria-hidden="true">{{ social.icon | safe }}</span>
            <span>{% if primarySocial == "linkedin" %}Contact on LinkedIn{% else %}View on GitHub{% endif %}</span>
          </a>
          {% endif %}
        {% endfor %}
      </div>

      <div class="profile-owner">
        <button class="profile-share-btn" id="share-btn" type="button"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12v8a2 2 0 002 2h12a2 2 0 002-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg><span>Copy profile link</span></button>
        <span class="share-status" id="share-status" aria-live="polite"></span>
        <p>Is this you? <a href="https://github.com/GRCEngClub/directory/edit/main/engineers/{{ github }}.md" target="_blank" rel="noopener">Edit your profile on GitHub</a></p>
        <p class="profile-owner-note">Sign in to GitHub to edit this profile and submit the change as your pull request.</p>
      </div>
    </aside>
  </div>
</div>
<script>
(function() {
  var back = document.querySelector('[data-directory-back]');
  if (back) {
    try {
      var q = sessionStorage.getItem('directoryQuery');
      if (q && q.charAt(0) === '?') back.setAttribute('href', '/' + q + '#directory');
    } catch (e) {}
  }

  var btn = document.getElementById('share-btn');
  var status = document.getElementById('share-status');
  if (!btn) return;
  var label = btn.querySelector('span');
  function onCopied() {
    label.textContent = 'Link copied';
    status.textContent = 'Profile link copied to clipboard';
    setTimeout(function() {
      label.textContent = 'Copy profile link';
      status.textContent = '';
    }, 2000);
  }
  btn.addEventListener('click', function() {
    var url = window.location.href.split('#')[0];
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(url).then(onCopied).catch(function() {
        window.prompt('Copy this URL:', url);
      });
    } else {
      window.prompt('Copy this URL:', url);
    }
  });
})();
</script>
