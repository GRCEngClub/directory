{% set specializations = engineer.data.specializations or [] %}
{% set frameworks = engineer.data.frameworks or [] %}
{% set availableFor = engineer.data.available_for or [] %}
{% set certifications = engineer.data.certifications or [] %}
{% set languages = engineer.data.languages or [] %}
{% set worksWithCount = frameworks.length + languages.length %}
{% set profileUrl = "/engineers/" + engineer.data.github + "/" %}
<article
  class="card engineer-card"
  data-specializations="{{ specializations | join(',') | lower }}"
  data-frameworks="{{ frameworks | join(',') | lower }}"
  data-certifications="{{ certifications | join(',') | lower }}"
  data-available="{{ availableFor | join(',') | lower }}"
  data-languages="{{ languages | join(',') | lower }}"
  data-name="{{ engineer.data.name | lower }}"
  data-title="{{ (engineer.data.title or '') | lower }}"
  data-company="{{ (engineer.data.company or '') | lower }}"
  data-location="{{ (engineer.data.location or '') | lower }}"
  data-profile-depth="{{ specializations.length + frameworks.length + availableFor.length + certifications.length + languages.length }}"
  {%- if paged %} data-paged{% endif %}
>
  <div class="card-header">
    <img
      src="https://github.com/{{ engineer.data.github }}.png?size=96"
      alt=""
      class="card-avatar"
      width="48"
      height="48"
      loading="lazy"
      decoding="async"
      data-initial="{{ engineer.data.name | first }}"
    >
    <div class="card-identity">
      <a href="{{ profileUrl }}" class="card-name">{{ engineer.data.name }}</a>
      {% if engineer.data.title %}<p class="card-title">{{ engineer.data.title }}</p>{% endif %}
      {% if engineer.data.company %}<p class="card-company">{{ engineer.data.company }}</p>{% endif %}
      {% if engineer.data.location %}<p class="card-location">{{ engineer.data.location }}</p>{% endif %}
    </div>
  </div>

  <div class="card-skill-group" data-tag-group data-limit="3">
    <p class="card-skill-label">Available for</p>
    {% if availableFor.length %}
    <div class="card-tags">
      {% for item in availableFor %}<span class="tag tag-available" data-key="available" data-value="{{ item | lower }}"{% if loop.index0 >= 3 %} hidden{% endif %}>{{ item | availabilityLabel }}</span>{% endfor %}
      <span class="tag tag-muted tag-more"{% if availableFor.length <= 3 %} hidden{% endif %}>+{{ availableFor.length - 3 }}</span>
    </div>
    {% else %}
    <p class="card-empty">Not listed</p>
    {% endif %}
  </div>

  <div class="card-skill-group" data-tag-group data-limit="3">
    <p class="card-skill-label">Specializes in</p>
    {% if specializations.length %}
    <div class="card-tags">
      {% for spec in specializations %}<span class="tag tag-accent" data-key="specializations" data-value="{{ spec | lower }}"{% if loop.index0 >= 3 %} hidden{% endif %}>{{ spec }}</span>{% endfor %}
      <span class="tag tag-muted tag-more"{% if specializations.length <= 3 %} hidden{% endif %}>+{{ specializations.length - 3 }}</span>
    </div>
    {% else %}
    <p class="card-empty">Not listed</p>
    {% endif %}
  </div>

  <div class="card-skill-group" data-tag-group data-limit="4">
    <p class="card-skill-label">Works with</p>
    {% if worksWithCount or certifications.length %}
    <div class="card-tags">
      {% for framework in frameworks %}<span class="tag tag-outline" data-key="frameworks" data-value="{{ framework | lower }}"{% if loop.index0 >= 4 %} hidden{% endif %}>{{ framework }}</span>{% endfor %}
      {% for language in languages %}<span class="tag tag-language" data-key="languages" data-value="{{ language | lower }}"{% if frameworks.length + loop.index0 >= 4 %} hidden{% endif %}>{{ language }}</span>{% endfor %}
      {% for cert in certifications %}<span class="tag tag-cert" data-key="certifications" data-value="{{ cert | lower }}" data-match-only hidden>{{ cert }}</span>{% endfor %}
      <span class="tag tag-muted tag-more"{% if worksWithCount <= 4 %} hidden{% endif %}>+{{ worksWithCount - 4 }}</span>
    </div>
    {% if not worksWithCount %}<p class="card-empty">Not listed</p>{% endif %}
    {% else %}
    <p class="card-empty">Not listed</p>
    {% endif %}
  </div>

  <div class="card-actions">
    {% for social in socials %}
      {% if (social.key == "linkedin" and engineer.data.linkedin) or (social.key == "github" and not engineer.data.linkedin) %}
      <a href="{{ social | socialUrl(engineer.data[social.key]) }}" class="card-contact" target="_blank" rel="noopener">
        <span class="card-contact-icon" aria-hidden="true">{{ social.icon | safe }}</span>
        <span>{{ social.label }}</span>
        <span class="sr-only">: {{ engineer.data.name }} (opens in new tab)</span>
      </a>
      {% endif %}
    {% endfor %}
  </div>
</article>
