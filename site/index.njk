---
layout: layouts/home.njk
title: GRC Engineer Directory - Find a GRC Engineer to Hire
permalink: /index.html
---
<section class="hero" id="hero">
  <div class="hero-content">
    <h1>Find engineers by the work they do.</h1>
    <p class="hero-tagline">GRC practitioners to hire, bring in as consultants, or learn from, searchable by specialization, framework, and tooling.</p>
  </div>
</section>

{% set activeJobs = collections.jobs %}
{% set chapterLeads = collections.chapters %}

{% include "partials/filter-bar.njk" %}

<section class="directory" id="directory" aria-label="Engineers">
  <div class="directory-toolbar" aria-hidden="true">
    <span>Engineer</span>
    <span>Available for</span>
    <span>Specializes in</span>
    <span>Works with</span>
    <span>Contact</span>
  </div>
  <div class="card-grid">
    {% for engineer in collections.engineers %}
      {% include "partials/engineer-card.njk" %}
    {% endfor %}
  </div>
  <div class="show-more" data-show-more hidden>
    <p class="show-more-status" data-show-more-status aria-live="polite"></p>
    <button type="button" class="btn btn-outline">Show more</button>
  </div>
  <div id="no-results" class="no-results" hidden>
    <p>No engineers match these filters.</p>
    <button type="button" class="btn btn-outline btn-compact" data-clear-filters>Clear filters</button>
  </div>
</section>

{% set browseGroups = [
  { title: "Specializations", field: "specializations", key: "specializations" },
  { title: "Frameworks", field: "frameworks", key: "frameworks" },
  { title: "Languages & tools", field: "languages", key: "languages" },
  { title: "Available for", field: "available_for", key: "available" }
] %}
<section class="browse" aria-labelledby="browse-heading">
  <div class="browse-header">
    <h2 id="browse-heading">Browse the directory</h2>
    <p class="browse-intro">The most common skills and frameworks across {{ collections.engineers.length }} profiles. Select one to filter the list.</p>
  </div>
  <div class="browse-grid">
    {% for group in browseGroups %}
    {% set rows = collections.engineers | topValues(group.field, 8, 2) %}
    {% set maxCount = rows[0].count if rows.length else 1 %}
    <div class="browse-group">
      <h3>{{ group.title }}</h3>
      <ol class="browse-list">
        {% for row in rows %}
        <li>
          <a href="/?{{ group.key }}={{ row.value | urlencode }}#directory" class="browse-row" style="--share-ratio: {{ (row.count / maxCount) | round(3) }}">
            <span class="browse-label">{% if group.key == "available" %}{{ row.label | availabilityLabel }}{% else %}{{ row.label }}{% endif %}</span>
            <span class="browse-count">{{ row.count }}</span>
          </a>
        </li>
        {% endfor %}
      </ol>
    </div>
    {% endfor %}
  </div>
</section>

<section class="jobs-preview chapters-preview" aria-labelledby="chapters-preview-heading">
  <div class="jobs-preview-header">
    <div>
      <h2 id="chapters-preview-heading">Chapter leads</h2>
      <p class="jobs-preview-copy">The people organizing GRC Engineering Club chapters, city by city.</p>
    </div>
    <a href="/chapters/" class="btn btn-outline">All chapters</a>
  </div>

  {% if chapterLeads.length %}
  <div class="card-grid chapters-preview-grid">
    {% for chapter in chapterLeads %}
      {% if loop.index0 < 3 %}
        {% include "partials/chapter-card.njk" %}
      {% endif %}
    {% endfor %}
  </div>
  {% else %}
  <p class="jobs-preview-empty">Chapter lead listings are coming soon. See <a href="https://grcengclub.com/chapters" target="_blank" rel="noopener">grcengclub.com/chapters</a> to start or join a chapter.</p>
  {% endif %}
</section>

<section class="jobs-preview" aria-labelledby="jobs-preview-heading">
  <div class="jobs-preview-header">
    <div>
      <h2 id="jobs-preview-heading">Open GRC engineering roles</h2>
      <p class="jobs-preview-copy">Roles imported from public company job boards and curated by the GRC Engineering Club.</p>
    </div>
    <a href="/jobs/" class="btn btn-outline">All jobs</a>
  </div>

  {% if activeJobs.length %}
  <div class="card-grid jobs-preview-grid">
    {% for job in activeJobs %}
      {% if loop.index0 < 3 %}
        {% include "partials/job-card.njk" %}
      {% endif %}
    {% endfor %}
  </div>
  {% else %}
  <p class="jobs-preview-empty">No jobs have been imported yet. Run <code>npm run import:jobs</code> to populate the board from free sources.</p>
  {% endif %}
</section>

<script src="/site/assets/js/search.js"></script>
<script src="/site/assets/js/filter-scroll.js"></script>
