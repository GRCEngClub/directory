---
layout: layouts/home.njk
title: GRC Engineer Directory - Find a GRC Engineer to Hire
permalink: /index.html
---
<section class="hero" id="hero">
  <div class="hero-content">
    <p class="hero-kicker">GRC Engineer Directory</p>
    <h1>Find engineers by the work they do.</h1>
    <p class="hero-tagline">Search real GRC practitioners by specialization, framework expertise, tooling, and availability.</p>
  </div>
</section>

{% set activeJobs = collections.jobs %}
{% set chapterLeads = collections.chapters %}

{% include "partials/filter-bar.njk" %}

<section class="directory">
  <div class="directory-toolbar">
    <span>Engineer</span>
    <span>Available for</span>
    <span>Specialization</span>
    <span>Frameworks & tools</span>
    <span>Actions</span>
  </div>
  <div class="card-grid">
    {% for engineer in collections.engineers %}
      {% include "partials/engineer-card.njk" %}
    {% endfor %}
  </div>
  <p id="no-results" class="no-results" style="display:none" aria-live="polite">No engineers match your filters. Try removing a filter or broadening your search.</p>
</section>

<section class="jobs-preview chapters-preview">
  <div class="jobs-preview-header">
    <div>
      <p class="jobs-kicker">Chapter Leads</p>
      <h2>GRC Engineering chapter leads</h2>
      <p class="jobs-preview-copy">Meet the local leaders organizing GRC Engineering Club chapters — presidents, VPs, and founding teams building community city by city.</p>
    </div>
    <a href="/chapters/" class="btn btn-outline">Browse chapter leads</a>
  </div>

  {% if chapterLeads.length %}
  <div class="card-grid chapters-preview-grid">
    {% for chapter in chapterLeads %}
      {% if loop.index0 < 3 %}
        {% include "partials/chapter-card.njk" %}
      {% endif %}
    {% endfor %}
  </div>
  {% else %}
  <p class="jobs-preview-empty">Chapter lead listings are coming soon. See <a href="https://grcengclub.com/chapters" target="_blank" rel="noopener">grcengclub.com/chapters</a> to start or join a chapter.</p>
  {% endif %}
</section>

<section class="jobs-preview">
  <div class="jobs-preview-header">
    <div>
      <p class="jobs-kicker">Open Roles</p>
      <h2>Open GRC Engineering Roles</h2>
      <p class="jobs-preview-copy">A community resource from the GRC Engineering Club that surfaces open GRC engineering roles alongside the member directory, using curated ATS imports.</p>
    </div>
    <a href="/jobs/" class="btn btn-outline">Browse jobs</a>
  </div>

  {% if activeJobs.length %}
  <div class="card-grid jobs-preview-grid">
    {% for job in activeJobs %}
      {% if loop.index0 < 3 %}
        {% include "partials/job-card.njk" %}
      {% endif %}
    {% endfor %}
  </div>
  {% else %}
  <p class="jobs-preview-empty">No jobs have been imported yet. Run <code>npm run import:jobs</code> to populate the board from free sources.</p>
  {% endif %}
</section>

<section class="insights">
  <h2>Community Insights</h2>
  <p class="insights-intro">A snapshot of the skills, frameworks, and availability across the directory.</p>
  <div class="insights-grid">
    <div class="insight-card">
      <h3>Top Specializations</h3>
      <canvas id="chart-specs" aria-label="Bar chart showing top specializations across engineers" role="img"></canvas>
    </div>
    <div class="insight-card">
      <h3>Framework Coverage</h3>
      <canvas id="chart-frameworks" aria-label="Doughnut chart showing framework coverage across engineers" role="img"></canvas>
    </div>
    <div class="insight-card">
      <h3>Availability</h3>
      <canvas id="chart-available" aria-label="Polar area chart showing availability types across engineers" role="img"></canvas>
    </div>
    <div class="insight-card">
      <h3>Languages & Tools</h3>
      <canvas id="chart-languages" aria-label="Bar chart showing languages and tools used by engineers" role="img"></canvas>
    </div>
  </div>
</section>

<script id="chart-data" type="application/json">
{
  "specializations": {{ collections.engineers | countValues("specializations") | dump | safe }},
  "frameworks": {{ collections.engineers | countValues("frameworks") | dump | safe }},
  "available_for": {{ collections.engineers | countValues("available_for") | dump | safe }},
  "languages": {{ collections.engineers | countValues("languages") | dump | safe }}
}
</script>

<script defer src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
<script src="/site/assets/js/search.js"></script>
<script src="/site/assets/js/filter-scroll.js"></script>
<script defer src="/site/assets/js/effects.js"></script>
