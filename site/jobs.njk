---
layout: layouts/base.njk
permalink: /jobs/index.html
eleventyComputed:
  title: "{{ collections.jobs.length }} Open GRC Engineering Jobs | GRC Engineer Directory"
  description: "Browse {{ collections.jobs.length }} open GRC engineering, IT audit, and compliance roles by framework, specialization, and work mode. A free GRC Engineering Club job board."
---
<section class="hero page-hero">
  <div class="hero-content">
    <h1>Open GRC engineering roles</h1>
    <p class="hero-tagline">Roles imported from public company job boards, filterable by framework, specialization, and work mode. "Listed" is the date the company published or last updated the posting.</p>
  </div>
</section>

{% include "partials/job-filter-bar.njk" %}

<section class="directory jobs-directory">
  {% if collections.jobs.length %}
  <div class="directory-toolbar jobs-toolbar" aria-hidden="true">
    <span>Role</span>
    <span>Company</span>
    <span>Work</span>
    <span>Focus</span>
    <span>Listed</span>
    <span>Apply</span>
  </div>
  <div class="card-grid">
    {% for job in collections.jobs %}
      {% set paged = loop.index0 >= 30 %}
      {% include "partials/job-card.njk" %}
    {% endfor %}
  </div>
  {% set jobCount = collections.jobs.length %}
  <div class="show-more" data-show-more{% if jobCount <= 30 %} hidden{% endif %}>
    <p class="show-more-status" data-show-more-status aria-live="polite">Showing 30 of {{ jobCount }}</p>
    <button type="button" class="btn btn-outline">Show {{ 30 if jobCount - 30 > 30 else jobCount - 30 }} more</button>
  </div>
  {% else %}
  <div class="jobs-empty">
    <h2>No jobs imported yet</h2>
    <p>Run <code>npm run import:jobs</code> to pull in roles from the curated ATS board list. The board is automation-first and currently relies on public Greenhouse and Ashby sources.</p>
  </div>
  {% endif %}

  <div id="no-results" class="no-results" hidden>
    <p>No roles match these filters.</p>
    <button type="button" class="btn btn-outline btn-compact" data-clear-filters>Clear filters</button>
  </div>
</section>

<script src="/site/assets/js/jobs-search.js"></script>
<script src="/site/assets/js/filter-scroll.js"></script>
